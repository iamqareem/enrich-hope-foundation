# Copy this file to .env and fill in real values. Never commit .env itself.

# Port the server listens on
PORT=3000

# Long random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The one admin account (the site owner). No user table — just these two values.
ADMIN_USERNAME=admin

# A bcrypt hash of the admin password — never the plain password itself.
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-real-password', 10))"
ADMIN_PASSWORD_HASH=

# ---- Pesapal (donations) ----
# Leave these blank and the Donate button shows a friendly "coming soon"
# message instead of erroring — safe to deploy before you have real
# merchant credentials.

# "sandbox" for testing, "live" once Pesapal approves the merchant account
PESAPAL_ENV=sandbox

# From the Pesapal merchant dashboard (Settings > API)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

# Your real public site URL, no trailing slash — Pesapal needs this to
# build the callback and IPN URLs, and it must be reachable over HTTPS
# from the internet (so this can't be localhost). e.g.:
#   PUBLIC_BASE_URL=https://enrichhopefoundation.org
PUBLIC_BASE_URL=
