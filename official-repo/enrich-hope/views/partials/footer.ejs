        <svg viewBox="0 0 100 100" width="30" height="30"><use href="#hope-mark-light"></use></svg>
      </span>
      <p class="brand-word">Enrich Hope<em>Foundation</em></p>
      <p class="footer-tag">Enriching Lives. Restoring Hope. Building Tomorrow.</p>
    </div>
    <div class="footer-col">
      <h4>Quick Links</h4>
      <a href="/#about">About Us</a>
      <a href="/#services">Programs</a>
      <a href="/blog">Blog</a>
      <a href="/#donate">Donate</a>
    </div>
    <div class="footer-col">
      <h4>Contact</h4>
      <% const c = typeof contact !== 'undefined' && contact ? contact : {}; %>
      <a href="mailto:<%= c.email || 'info@enrichhopefoundation.org' %>"><%= c.email || 'info@enrichhopefoundation.org' %></a>
      <a href="tel:<%= (c.phone || '+256701707471').replace(/\s+/g, '') %>"><%= c.phone || '+256 701 707 471' %></a>
      <p><%= c.location || 'Kampala, Uganda' %></p>
